<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rewordly.Desktop</RootNamespace>
    <AssemblyName>Rewordly</AssemblyName>
    <ApplicationIcon>Assets/Rewordly.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.2.0</Version>
    <Product>Rewordly</Product>
    <Authors>Shobhit Kumar Prabhakar</Authors>
    <Company>Shobhit Kumar Prabhakar</Company>
    <Copyright>Copyright (c) 2026 Shobhit Kumar Prabhakar</Copyright>
    <Description>AI text rewriting from any app on Windows, macOS and Linux</Description>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/icon.png" LogicalName="Rewordly.icon.png" />
    <AvaloniaResource Include="Assets/Brand/*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="SharpHook" Version="7.1.3" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rewordly.Core/Rewordly.Core.csproj" />
  </ItemGroup>
</Project>
