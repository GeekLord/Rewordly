<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rewordly.Core</RootNamespace>
    <Version>2.1.1</Version>
    <PackageId>Rewordly.Core</PackageId>
    <Authors>Shobhit Kumar Prabhakar</Authors>
    <Description>Rewordly prompt templates, settings and AI provider clients (Gemini, OpenAI-compatible, Ollama).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GeekLord/Rewordly</RepositoryUrl>
    <PackageProjectUrl>https://github.com/GeekLord/Rewordly</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../prompts/agent-prompt/*.txt" LogicalName="agent-prompt/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
